---
import { API_URL } from 'astro:env/client';

interface Props {
	id: string;
}

const { id } = Astro.props;

const src = `${API_URL}/stream/${id}/master.m3u8`;
---

<video-player>
	<video-minimal-skin>
		<hlsjs-video src={src} playsinline></hlsjs-video>
	</video-minimal-skin>
</video-player>

<script>
	import '@videojs/html/video/player';
	import '@videojs/html/video/minimal-skin';
	import '@videojs/html/media/hlsjs-video';
</script>
